---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
---

<Layout>
  <table class="min-w-full table-auto border-collapse rounded-xl overflow-hidden shadow-xl backdrop-blur-md bg-white/20">
  <thead class="bg-white/30 text-white uppercase tracking-wider text-sm">
    <tr>
      <th class="px-6 py-3">Name</th>
      <th class="px-6 py-3">Age</th>
      <th class="px-6 py-3">Role</th>
    </tr>
  </thead>
  <tbody class="divide-y divide-white/30 text-white">
    <tr class="hover:bg-white/20 transition">
      <td class="px-6 py-4">Alice</td>
      <td class="px-6 py-4">28</td>
      <td class="px-6 py-4">Engineer</td>
    </tr>
    <tr class="hover:bg-white/20 transition">
      <td class="px-6 py-4">Bob</td>
      <td class="px-6 py-4">34</td>
      <td class="px-6 py-4">Designer</td>
    </tr>
  </tbody>
</table>
</Layout>
