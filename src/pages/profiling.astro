---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
---

<Layout>
  <section class="my-8 px-4">
  <center><h2 class="text-3xl font-extrabold text-indigo-200 mb-6 tracking-tight">Profiling Results</h2></center>

  <table class="w-full max-w-xl mx-auto table-auto border-collapse rounded-xl overflow-hidden shadow-md bg-white font-sans">
    <thead class="bg-indigo-200 text-indigo-900 uppercase text-xs tracking-wide font-bold">
      <tr>
        <th class="px-6 py-4 text-left">Benchmark</th>
        <th class="px-6 py-4 text-left">Cosimulation Cycles</th>
        <th class="px-6 py-4 text-left">LightningSim Cycles</th>
        <th class="px-6 py-4 text-left">OmniSim Cycles</th>
        <th class="px-6 py-4 text-left">Cosimulation Runtime (in s)</th>
        <th class="px-6 py-4 text-left">LightningSim Runtime (in s)</th>
        <th class="px-6 py-4 text-left">OmniSim Runtime (in s)</th>
        <th class="px-6 py-4 text-left">LightningSim Speedup (vs. Cosim)</th>
        <th class="px-6 py-4 text-left">OmniSim Speedup (vs. Cosim)</th>
        <th class="px-6 py-4 text-left">OmniSim Speedup (vs. LightningSim)</th>
      </tr>
    </thead>
    <tbody class="text-slate-800 divide-y divide-indigo-100 text-sm">
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Fixed-point square root</td>
        <td class="px-4 py-2">30</td>
        <td class="px-4 py-2">30</td>
        <td class="px-4 py-2">30</td>
        <td class="px-4 py-2">58.00</td>
        <td class="px-4 py-2">6.14</td>
        <td class="px-4 py-2">3.20</td>
        <td class="px-4 py-2 font-bold text-indigo-700">9.45&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">18.13&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.92&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">FIR filter</td>
        <td class="px-4 py-2">172</td>
        <td class="px-4 py-2">172</td>
        <td class="px-4 py-2">172</td>
        <td class="px-4 py-2">52.00</td>
        <td class="px-4 py-2">2.64</td>
        <td class="px-4 py-2">2.09</td>
        <td class="px-4 py-2 font-bold text-indigo-700">19.72&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">24.82&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.26&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Fixed-point window conv</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">61.00</td>
        <td class="px-4 py-2">4.54</td>
        <td class="px-4 py-2">2.70</td>
        <td class="px-4 py-2 font-bold text-indigo-700">13.41&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">22.60&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.68&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Floating-point conv</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">112.00</td>
        <td class="px-4 py-2">2.81</td>
        <td class="px-4 py-2">2.41</td>
        <td class="px-4 py-2 font-bold text-indigo-700">39.86&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">46.50&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.17&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Arbitrary Precision ALU</td>
        <td class="px-4 py-2">36</td>
        <td class="px-4 py-2">36</td>
        <td class="px-4 py-2">36</td>
        <td class="px-4 py-2">68.00</td>
        <td class="px-4 py-2">2.50</td>
        <td class="px-4 py-2">1.93</td>
        <td class="px-4 py-2 font-bold text-indigo-700">27.20&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">35.16&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.30&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Parallel loops</td>
        <td class="px-4 py-2">32</td>
        <td class="px-4 py-2">32</td>
        <td class="px-4 py-2">32</td>
        <td class="px-4 py-2">58.00</td>
        <td class="px-4 py-2">2.77</td>
        <td class="px-4 py-2">2.23</td>
        <td class="px-4 py-2 font-bold text-indigo-700">20.96&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">26.02&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.24&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Imperfect loops</td>
        <td class="px-4 py-2">34</td>
        <td class="px-4 py-2">34</td>
        <td class="px-4 py-2">34</td>
        <td class="px-4 py-2">64.00</td>
        <td class="px-4 py-2">2.75</td>
        <td class="px-4 py-2">2.22</td>
        <td class="px-4 py-2 font-bold text-indigo-700">23.25&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">28.82&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.24&times;</td>
      </tr>
    </tbody>
  </table>
</section>


</Layout>
