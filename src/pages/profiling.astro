---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
---

<Layout>
  <table class="min-w-full table-auto border border-purple-500 rounded-lg shadow-lg">
  <thead class="bg-gradient-to-r from-indigo-700 to-purple-600 text-white">
    <tr>
      <th class="px-6 py-3 text-left text-sm font-bold tracking-wider">Name</th>
      <th class="px-6 py-3 text-left text-sm font-bold tracking-wider">Age</th>
      <th class="px-6 py-3 text-left text-sm font-bold tracking-wider">Role</th>
    </tr>
  </thead>
  <tbody class="bg-black/70 text-purple-200 divide-y divide-purple-600">
    <tr class="hover:bg-purple-800/40 transition">
      <td class="px-6 py-4">Alice</td>
      <td class="px-6 py-4">28</td>
      <td class="px-6 py-4">Engineer</td>
    </tr>
    <tr class="hover:bg-purple-800/40 transition">
      <td class="px-6 py-4">Bob</td>
      <td class="px-6 py-4">34</td>
      <td class="px-6 py-4">Designer</td>
    </tr>
  </tbody>
</table>
</Layout>
