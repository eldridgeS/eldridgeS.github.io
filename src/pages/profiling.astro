---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
---

<Layout>
    <table class="min-w-full table-auto border-collapse rounded-xl overflow-hidden shadow-lg backdrop-blur-md">
    <thead class="bg-black/60 text-white">
    <tr>
      <th class="px-6 py-3 text-left text-sm font-semibold tracking-wider">Name</th>
      <th class="px-6 py-3 text-left text-sm font-semibold tracking-wider">Age</th>
      <th class="px-6 py-3 text-left text-sm font-semibold tracking-wider">Role</th>
    </tr>
    </thead>
    <tbody class="bg-white/80 text-gray-900 divide-y divide-gray-300">
    <tr class="hover:bg-white/90 transition">
      <td class="px-6 py-4 text-sm">Alice</td>
      <td class="px-6 py-4 text-sm">28</td>
      <td class="px-6 py-4 text-sm">Engineer</td>
    </tr>
    <tr class="hover:bg-white/90 transition">
      <td class="px-6 py-4 text-sm">Bob</td>
      <td class="px-6 py-4 text-sm">34</td>
      <td class="px-6 py-4 text-sm">Designer</td>
    </tr>
    </tbody>
    </table>


</Layout>
