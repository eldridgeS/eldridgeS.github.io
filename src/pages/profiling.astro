---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
---

<Layout>
  <section class="my-8 px-4">
  <center><h2 class="text-3xl font-extrabold text-indigo-200 mb-6 tracking-tight">Profiling Results</h2></center>

  <table class="w-full max-w-xl mx-auto table-auto border-collapse rounded-xl overflow-hidden shadow-md bg-white font-sans">
    <thead class="bg-indigo-200 text-indigo-900 uppercase text-xs tracking-wide font-bold">
      <tr>
        <th class="px-6 py-4 text-left">Benchmark</th>
        <th class="px-6 py-4 text-left">Cosimulation Cycles</th>
        <th class="px-6 py-4 text-left">LightningSim Cycles</th>
        <th class="px-6 py-4 text-left">OmniSim Cycles</th>
        <th class="px-6 py-4 text-left">Cosimulation Runtime (in s)</th>
        <th class="px-6 py-4 text-left">LightningSim Runtime (in s)</th>
        <th class="px-6 py-4 text-left">OmniSim Runtime (in s)</th>
        <th class="px-6 py-4 text-left">LightningSim Speedup (vs. Cosim)</th>
        <th class="px-6 py-4 text-left">OmniSim Speedup (vs. Cosim)</th>
        <th class="px-6 py-4 text-left">OmniSim Speedup (vs. LightningSim)</th>
      </tr>
    </thead>
    <tbody class="text-slate-800 divide-y divide-indigo-100 text-sm">
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Fixed-point square root</td>
        <td class="px-4 py-2">30</td>
        <td class="px-4 py-2">30</td>
        <td class="px-4 py-2">30</td>
        <td class="px-4 py-2">27.25</td>
        <td class="px-4 py-2">4.97</td>
        <td class="px-4 py-2">3.65</td>
        <td class="px-4 py-2 font-bold text-indigo-700">5.48&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">7.47&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.36&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">FIR filter</td>
        <td class="px-4 py-2">172</td>
        <td class="px-4 py-2">172</td>
        <td class="px-4 py-2">172</td>
        <td class="px-4 py-2">20.12</td>
        <td class="px-4 py-2">2.43</td>
        <td class="px-4 py-2">1.94</td>
        <td class="px-4 py-2 font-bold text-indigo-700">8.23&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">10.37&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.25&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Fixed-point window conv</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">28.30</td>
        <td class="px-4 py-2">3.69</td>
        <td class="px-4 py-2">3.15</td>
        <td class="px-4 py-2 font-bold text-indigo-700">7.67&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">8.98&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.71&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Floating-point conv</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">35</td>
        <td class="px-4 py-2">49.78</td>
        <td class="px-4 py-2">2.42</td>
        <td class="px-4 py-2">2.46</td>
        <td class="px-4 py-2 font-bold text-indigo-700">20.57&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">20.24&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">0.98&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Arbitrary Precision ALU</td>
        <td class="px-4 py-2">36</td>
        <td class="px-4 py-2">36</td>
        <td class="px-4 py-2">36</td>
        <td class="px-4 py-2">24.17</td>
        <td class="px-4 py-2">2.12</td>
        <td class="px-4 py-2">2.03</td>
        <td class="px-4 py-2 font-bold text-indigo-700">11.40&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">11.91&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.04&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Parallel loops</td>
        <td class="px-4 py-2">32</td>
        <td class="px-4 py-2">32</td>
        <td class="px-4 py-2">32</td>
        <td class="px-4 py-2">26.81</td>
        <td class="px-4 py-2">2.34</td>
        <td class="px-4 py-2">2.16</td>
        <td class="px-4 py-2 font-bold text-indigo-700">11.48&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">12.41&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.08&times;</td>
      </tr>
      <tr class="bg-slate-50 hover:bg-indigo-300 transition">
        <td class="px-4 py-2 font-medium">Imperfect loops</td>
        <td class="px-4 py-2">34</td>
        <td class="px-4 py-2">34</td>
        <td class="px-4 py-2">34</td>
        <td class="px-4 py-2">25.80</td>
        <td class="px-4 py-2">2.24</td>
        <td class="px-4 py-2">2.13</td>
        <td class="px-4 py-2 font-bold text-indigo-700">11.52&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">12.11&times;</td>
        <td class="px-4 py-2 font-bold text-indigo-700">1.05&times;</td>
      </tr>
    </tbody>
  </table>
</section>


</Layout>
