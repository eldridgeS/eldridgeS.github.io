---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Solutions & Technology',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Solutions & Technology"
    title="Cutting-Edge Hardware Design Tools"
    subtitle="LightningX offers specialized solutions for chip and FPGA designers. Leveraging research from the Sharc Lab at Georgia Tech, we deliver tools that reduce design time and development costs."
    actions={[{ variant: 'primary', target: '_blank', text: 'Contact us', href: 'mailto:hi@lightningx-da.com' }]}
    image={{
      src: '~/assets/images/featured.jpg',
      alt: 'LightningX Technology Stack',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Core Technology Areas"
    subtitle="Explore our specialized expertise in hardware design and optimization."
    columns={3}
    items={[
      {
        title: 'HLS Optimization',
        description:
          'Advanced High-Level Synthesis optimization techniques designed to improve performance, reduce resource utilization, and accelerate design cycles for complex chip architectures.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'FPGA Acceleration',
        description:
          'Comprehensive FPGA design tools and methodologies that enable rapid prototyping, hardware acceleration, and efficient deployment of compute-intensive applications.',
        icon: 'tabler:cpu',
      },
      {
        title: 'GNN Inference',
        description: `Graph Neural Network inference optimization and acceleration techniques for machine learning workloads on hardware accelerators.`,
        icon: 'tabler:brain',
      },
      {
        title: 'Cycle-Accurate Simulation',
        description:
          'Ultra-fast simulation platforms that provide cycle-accurate modeling with 99.9% accuracy, enabling designers to validate performance without slow RTL simulation.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Design Validation',
        description:
          'Comprehensive validation and verification tools to ensure correctness and performance of complex HLS and FPGA designs across diverse use cases.',
        icon: 'tabler:check',
      },
      {
        title: 'Open-Source & Commercial',
        description:
          'Both open-source tools (built with the research community) and commercial solutions tailored for production hardware design workflows.',
        icon: 'tabler:git-branch',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Reduce Time-to-Market',
        description:
          'LightningSim accelerates design validation by 100x compared to traditional C/RTL co-simulation, enabling faster iteration and earlier market entry.',
        icon: 'tabler:clock',
      },
      {
        title: 'Lower Development Costs',
        description:
          'Streamline your design workflows and eliminate costly simulation bottlenecks with our optimized toolchain.',
        icon: 'tabler:coin',
      },
      {
        title: 'Proven Research Foundation',
        description:
          'Built on peer-reviewed research published at top conferences, our solutions are backed by academic rigor and industry validation.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Seamless Integration',
        description:
          'Our tools integrate directly with existing HLS workflows without requiring design modifications, ensuring smooth adoption.',
        icon: 'tabler:link',
      },
    ]}
    image={{
      src: '~/assets/images/lightningsim.svg',
      alt: 'LightningSim Technology',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Why Choose LightningX</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Industry-Ready Solutions',
        description:
          'Our tools are production-ready and used by leading hardware companies for mission-critical chip design projects.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Open Source Community',
        description:
          'Access the open-source LightningSim implementation to integrate with your research and educational projects at no cost.',
        icon: 'tabler:code-dots',
      },
      {
        title: 'Expert Support',
        description:
          'Get direct access to the research team behind LightningX for technical guidance, custom extensions, and optimization services.',
        icon: 'tabler:users',
      },
      {
        title: 'Continuous Innovation',
        description:
          'Benefit from ongoing research and development as we expand the LightningX toolkit with new capabilities and performance improvements.',
        icon: 'tabler:bulb',
      },
    ]}
    image={{
      src: '~/assets/images/featured.jpg',
      alt: 'LightningX Innovation',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Our Commitment</h3>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="What Our Users Say"
    testimonials={[
      {
        testimonial: `LightningSim dramatically accelerated our design validation cycle. What used to take hours now takes minutes. It's been a game-changer for our HLS development.`,
        name: 'Dr. Jane Smith',
        job: 'Senior Hardware Designer, TechCorp',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Jane Smith Image',
        },
      },
      {
        testimonial: `The integration process was seamless. We didn't need to change any of our existing HLS designs, and the simulation accuracy is incredible at 99.9%.`,
        name: 'Prof. John Chen',
        job: 'Computer Architecture Researcher',
        image: {
          src: 'https://images.unsplash.com/photo-1561406636-b80293969660?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'John Chen Image',
        },
      },
      {
        testimonial: `Being part of the CREATE-X research initiative, we can confidently recommend LightningX to anyone serious about accelerating their chip design workflow.`,
        name: 'Lisa Wong',
        job: 'FPGA Design Lead',
        image: {
          src: 'https://images.unsplash.com/photo-1545167622-3a6ac756afa4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=824&q=80',
          alt: 'Lisa Wong Image',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'Learn more on GitHub',
      href: 'https://github.com/sharc-lab/LightningSim',
      icon: 'tabler:chevron-right',
    }}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: 'mailto:hi@lightningx-da.com',
      },
    ]}
    title="Ready to Accelerate Your Design?"
    subtitle="Contact LightningX today to discuss how our solutions can transform your chip and FPGA design workflows."
  />
</Layout>
