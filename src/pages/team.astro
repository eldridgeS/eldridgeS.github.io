---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Our Team — LightningX',
};
---

<Layout metadata={metadata}>

  <!-- Hero Section -->
  <Hero
    tagline="Our Team"
    title=`The People Behind Lightning<svg viewBox="550 0 95 112" style="height:0.78em;display:inline-block;vertical-align:baseline;margin-bottom:-0.02em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M577 5H552L578 45L593 29.6154L577 5ZM616 65L598.647 76.7647L617 105H642L616 65Z" fill="currentColor"/><path d="M642 5L603 45L616 65L557 105H552L591 65L578 45L617 5H642Z" fill="#EAAA00"/></svg>`
    subtitle="Researchers and engineers from Georgia Tech's Sharc Lab, building production-grade EDA tools grounded in peer-reviewed research."
  />

  <!-- Team Members -->
  <section class="-mt-8 pb-16 md:pb-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2 justify-items-center">

        <!-- Callie Hao -->
        <div class="flex flex-col items-center text-center">
          <div class="w-32 h-32 md:w-36 md:h-36 rounded-2xl overflow-hidden mb-4">
            <img src="/images/Callie.png" alt="Dr. Callie Hao" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <h3 class="text-base font-semibold text-default dark:text-white">Dr. Callie Hao</h3>
          <p class="text-sm font-medium text-primary mt-1">Chief Technology Officer</p>
        </div>

        <!-- Rishov Sarkar -->
        <div class="flex flex-col items-center text-center">
          <div class="w-32 h-32 md:w-36 md:h-36 rounded-2xl overflow-hidden mb-4">
            <img src="/images/Rishov.png" alt="Rishov Sarkar" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <h3 class="text-base font-semibold text-default dark:text-white">Rishov Sarkar</h3>
          <p class="text-sm font-medium text-primary mt-1">Chief Executive Officer</p>
        </div>

        <!-- Pramath -->
        <div class="flex flex-col items-center text-center">
          <div class="w-32 h-32 md:w-36 md:h-36 rounded-2xl overflow-hidden mb-4">
            <img src="/images/Pramath.png" alt="Pramath Balisavira Guruprasanna" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <h3 class="text-base font-semibold text-default dark:text-white">Pramath B. Guruprasanna</h3>
          <p class="text-sm font-medium text-primary mt-1">Engineering Lead</p>
        </div>

        <!-- Sudiksha -->
        <div class="flex flex-col items-center text-center">
          <div class="w-32 h-32 md:w-36 md:h-36 rounded-2xl overflow-hidden mb-4">
            <img src="/images/Sudiksha.png" alt="Sudiksha Das" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <h3 class="text-base font-semibold text-default dark:text-white">Sudiksha Das</h3>
          <p class="text-sm font-medium text-primary mt-1">Management Lead</p>
        </div>

        <!-- Eldridge -->
        <div class="flex flex-col items-center text-center">
          <div class="w-32 h-32 md:w-36 md:h-36 rounded-2xl overflow-hidden mb-4">
            <img src="/images/Eldridge.jpg" alt="Eldridge Surianto" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <h3 class="text-base font-semibold text-default dark:text-white">Eldridge Surianto</h3>
          <p class="text-sm font-medium text-primary mt-1">Software</p>
        </div>

        <!-- Kamya -->
        <div class="flex flex-col items-center text-center">
          <div class="w-32 h-32 md:w-36 md:h-36 rounded-2xl overflow-hidden mb-4">
            <img src="/images/Kamya.jpeg" alt="Kamya Hari" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <h3 class="text-base font-semibold text-default dark:text-white">Kamya Hari</h3>
          <p class="text-sm font-medium text-primary mt-1">Software</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Research Credentials -->
  <section id="papers" class="py-12 md:py-16 bg-gray-50 dark:bg-slate-900/50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-sm font-semibold tracking-wide uppercase text-secondary dark:text-blue-200">Where We Publish</p>
        <h2 class="text-3xl md:text-4xl font-bold mt-2 dark:text-white">Grounded in Peer-Reviewed Research</h2>
        <p class="text-muted dark:text-slate-400 mt-3 max-w-2xl mx-auto">
          Our tools are backed by publications at the highest-tier computer architecture and FPGA conferences.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-6 text-center">
        <div class="p-6 rounded-xl bg-white dark:bg-slate-800 shadow-sm border border-gray-100 dark:border-slate-700">
          <a href="https://arxiv.org/abs/2508.19299" target="_blank" rel="noopener noreferrer">
            <p class="text-2xl font-bold text-primary">MICRO '25</p>
            <p class="text-sm text-muted dark:text-slate-400 mt-1"> 58th IEEE/ACM International Symposium on Microarchitecture</p>
          </a>
        </div>
        <div class="p-6 rounded-xl bg-white dark:bg-slate-800 shadow-sm border border-gray-100 dark:border-slate-700">
          <a href="https://arxiv.org/abs/2404.09471" target="_blank" rel="noopener noreferrer">
            <p class="text-2xl font-bold text-primary">FCCM '24</p>
            <p class="text-sm text-muted dark:text-slate-400 mt-1">32nd IEEE International Symposium on Field-Programmable Custom Computing Machines</p>
          </a>
        </div>
        <div class="p-6 rounded-xl bg-white dark:bg-slate-800 shadow-sm border border-gray-100 dark:border-slate-700 relative">
          <a href="https://arxiv.org/abs/2304.11219" target="_blank" rel="noopener noreferrer">
            <p class="text-2xl font-bold text-primary">FCCM '23</p>
            <p class="text-sm text-muted dark:text-slate-400 mt-1">31st IEEE International Symposium on Field-Programmable Custom Computing Machines</p>
            <span class="inline-block mt-2 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300">🏆 Best Paper Runner-Up</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <CallToAction
    title="Interested in Working With Us?"
    subtitle="We're a small, focused team solving hard problems in EDA. If that sounds like your kind of challenge, let's talk."
    actions={[
      {
        variant: 'primary',
        text: 'Get in Touch',
        href: '/contact',
        icon: 'tabler:arrow-right',
      }
    ]}
  />
</Layout>