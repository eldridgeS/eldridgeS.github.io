---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
import SmallLogo from '~/assets/images/logo-small.svg';

const metadata = {
  title: 'LightningX — Accelerate Time-to-Market',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- Hero Section -->
<Hero
image={{ src: '~/assets/images/featured.PNG', alt: 'Wide Front Page Image' }}
>
<Fragment slot="title">
    <Image src={SmallLogo} class="inline-block align-baseline" style="height: 0.7333em; width: auto;" alt="X" /> is for <span class="text-accent dark:text-white highlight">exascale.</span>
</Fragment>
<Fragment slot="subtitle">
  LightningX technology accelerates design time for <span class="font-semibold">exascale chip and FPGA designs.</span>
</Fragment>
</Hero>

  <!-- Features Section -->
  <Features
    id="features"
    title="Our Vision"
    subtitle="Innovative solutions designed to empower chip and FPGA designers with cutting-edge tools."
    items={[
      {
        title: 'LightningSim',
        description:
          'Our flagship simulation platform, LightningSim, offers unparalleled speed and accuracy to enhance your design process.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'Future Innovations',
        description:
          'From synthesis tools to AI-driven optimization, we’re actively developing a suite of products to transform design workflows.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Customization',
        description:
          'Tailored solutions to meet the unique challenges of your design projects, ensuring maximum efficiency and productivity.',
        icon: 'tabler:adjustments',
      },
    ]}
  />

  <!-- Steps Section -->
  <Steps
    title="Get to Know LightningSim"
    items={[
      {
        title: 'Feature 1: <span class="font-medium">Ultra-fast Cycle-accurate Simulation</span>',
        description:
          'Don\'t know your HLS design performance? Don\'t want to use super-slow C/RTL co-simulation? LightningSim accelerates your C/RTL co-simulation by two orders, with 99.9% accuracy in simulating cycle counts.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Feature 2: <span class="font-medium">Ultra-fast FIFO Sizing</span>',
        description:
          'Don\'t know best FIFO sizes? LightningSim evaluates possible solutions in parallel, within miliseconds.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Feature 3: <span class="font-medium">Ultra-simple Integration with HLS</span>',
        description:
          'Don\'t want to change your existing HLS designs? LightningSim does not require any changes -- just by pointing to your synthesized HLS design and we are good to go.',
        icon: 'tabler:leaf',
      },
    ]}
    image={{
      src: '~/assets/images/lightningsim.svg', alt: 'LightningSim logo',
    }}
  />

  <!-- Call to Action Section -->
  <CallToAction
    actions={[{ text: 'Contact Us', href: 'mailto:info@lightningx-da.com', variant: 'primary' }]}
  >
    <Fragment slot="title">Get in Touch</Fragment>
    <Fragment slot="subtitle">
      Ready to transform your design process? Contact us today to learn how LightningSim and our upcoming tools can revolutionize your projects.
    </Fragment>
  </CallToAction>
</Layout>

