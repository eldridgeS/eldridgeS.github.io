---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
import SmallLogo from '~/assets/images/logo-small.svg';
import SmallLogoDark from '~/assets/images/logo-small-dark.svg';

const metadata = {
  title: 'LightningX — Accelerate Time-to-Market',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- Hero Section -->
<Hero
image={{ src: '~/assets/images/featured.jpg', alt: 'Photo of FPGA development board with LightningSim UI fading in on the right' }}
>
<Fragment slot="title">
  <span class="text-accent dark:text-white highlight">Faster Simulation.</span><br/>
  <span class="text-accent dark:text-white highlight">Scalable Optimization.</span>
</Fragment>
<Fragment slot="subtitle">
  LightningX accelerates design time and reduces costs for chip and FPGA designers. Discover tools built by engineers from <a href="https://sharclab.ece.gatech.edu/" target="_blank" rel="noopener noreferrer" style="color: #FF69B4; text-decoration: underline;">Sharc Lab</a> at Georgia Tech.
  <br/><br/>
  <Image src={SmallLogo} class="align-baseline inline-block dark:hidden mr-1" style="height: 0.9em; width: auto;" alt="X" />
  <Image src={SmallLogoDark} class="align-baseline hidden dark:inline-block mr-1" style="height: 0.9em; width: auto;" alt="X" />
  <span style="font-size: 0.95em; font-style: italic;">is for exascale.</span>
</Fragment>
</Hero>

  <!-- Features Section -->
  <Features
    id="features"
    title="Our Core Offerings"
    subtitle="LightningX provides cutting-edge tools for chip and FPGA design optimization, reducing time-to-market and development costs."
    items={[
      {
        title: 'LightningSim',
        description:
          'Ultra-fast cycle-accurate simulation for HLS designs. Accelerate C/RTL co-simulation by 100x with 99.9% accuracy and integrate seamlessly into existing workflows.',
        icon: 'tabler:rocket',
      },
      {
        title: 'HLS Optimization',
        description:
          'Advanced synthesis optimization techniques to improve performance and resource utilization in High-Level Synthesis designs.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'EDA Acceleration',
        description:
          'Specialized tools for FPGA and ASIC design acceleration, enabling faster prototyping and deployment for hardware-accelerated applications.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Performance Analysis',
        description:
          'Comprehensive analysis and profiling tools to identify bottlenecks, optimize resource allocation, and maximize design efficiency.',
        icon: 'tabler:chart-line',
      },
    ]}
  />

  <!-- Steps Section -->
  <Steps
    title="Get to Know LightningSim"
    isDark={true}
    items={[
      {
        title: 'Feature 1: <span class="font-medium">Ultra-fast Cycle-accurate Simulation</span>',
        description:
          'Don\'t know your HLS design performance? Don\'t want to use super-slow C/RTL co-simulation? LightningSim accelerates your C/RTL co-simulation by two orders, with 99.9% accuracy in simulating cycle counts.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Feature 2: <span class="font-medium">Ultra-fast FIFO Sizing</span>',
        description:
          'Don\'t know best FIFO sizes? LightningSim evaluates possible solutions in parallel, within miliseconds.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Feature 3: <span class="font-medium">Ultra-simple Integration with HLS</span>',
        description:
          'Don\'t want to change your existing HLS designs? LightningSim does not require any changes -- just by pointing to your synthesized HLS design and we are good to go.',
        icon: 'tabler:plug',
      },
    ]}
    image={`<iframe width="100%" height="400" src="https://www.youtube.com/embed/JCQniXBqYjI" title="LightningSim Demo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen class="rounded-md shadow-lg"></iframe>`}
    isReversed={true}
  />

  <Steps 
  title="Deep Dive into LightningSim" 
  isDark={true}
  items={[
    {
      title: `Watch our
        <a href="https://www.youtube.com/watch?v=JCQniXBqYjI&pp=ygUMTGlnaHRuaW5nU2lt" target="_blank" rel="noopener noreferrer" style="color: #FF69B4; text-decoration: underline; font-style: italic;">talk</a> to 
        get to know LightningSim better`,
      icon: 'tabler:video'
    },
    {
      title: `Understand how LightningSim works from our published papers – 
        <a href="https://arxiv.org/abs/2304.11219" target="_blank" rel="noopener noreferrer" style="color: #FF69B4; text-decoration: underline; font-style: italic;">LightningSim</a>, 
        <a href="https://arxiv.org/abs/2404.09471" target="_blank" rel="noopener noreferrer" style="color: #FF69B4; text-decoration: underline; font-style: italic;">LightningSimV2</a>,
        and
        <a href="https://arxiv.org/abs/2508.19299" target="_blank" rel="noopener noreferrer" style="color: #FF69B4; text-decoration: underline; font-style: italic;">OmniSim</a>`,
      icon: 'tabler:file'
    },
    {
      title: `Check out the
        <a href="https://lightningsim-doc.readthedocs.io/en/latest/" target="_blank" rel="noopener noreferrer" style="color: #FF69B4; text-decoration: underline; font-style: italic;">documentation</a> 
        to set up LightningSim`,
      icon: 'tabler:folder'
    },
    {
      title: `Get hands-on with LightningSim using our open-sourced code on
        <a href="https://github.com/sharc-lab/LightningSim.git" target="_blank" rel="noopener noreferrer" style="color: #FF69B4; text-decoration: underline; font-style: italic;">GitHub</a> `,
      icon: 'tabler:git-fork'
    },
  ]}
  />

  <!-- Call to Action Section -->
  <CallToAction
    actions={[{ text: 'Contact Us', href: 'mailto:hi@lightningx-da.com', variant: 'primary' }]}
  >
    <Fragment slot="title">Get in Touch</Fragment>
    <Fragment slot="subtitle">
      Ready to transform your design process? Contact us today to learn how LightningSim and our upcoming tools can revolutionize your projects.
    </Fragment>
  </CallToAction>
</Layout>

