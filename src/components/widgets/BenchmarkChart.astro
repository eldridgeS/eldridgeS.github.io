---
// Benchmark chart component showing speedup comparisons
---

<section class="py-16 md:py-20 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <p class="text-sm font-semibold tracking-wide uppercase text-secondary dark:text-blue-200">Visualization</p>
      <h2 class="text-3xl md:text-4xl font-bold mt-2 dark:text-white">Runtime Performance Comparison</h2>
      <p class="text-muted dark:text-slate-400 mt-3 max-w-2xl mx-auto">Actual runtimes across representative benchmarks showing dramatic acceleration vs traditional C/RTL co-simulation.</p>
    </div>

    <div class="bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-xl p-6 md:p-8 shadow-sm">
      <canvas id="speedupChart"></canvas>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>

  // Representative benchmarks showcasing different categories
  const benchmarkData = [
    { name: 'FIR Filter', cosim: 20.12, ls: 2.43, os: 1.94 },
    { name: 'Convolution', cosim: 49.78, ls: 2.42, os: 2.46 },
    { name: 'FFT (Unopt)', cosim: 153.53, ls: 2.78, os: 2.91 },
    { name: 'Parallel Loops', cosim: 26.81, ls: 2.34, os: 2.16 },
    { name: 'FlowGNN - DGN', cosim: 996.13, ls: 26.90, os: 11.71 },
    { name: 'FlowGNN - GIN', cosim: 4219.85, ls: 28.90, os: 11.97 },
  ];

  const labels = benchmarkData.map(b => b.name);
  const cosimData = benchmarkData.map(b => b.cosim);
  const lsData = benchmarkData.map(b => b.ls);
  const osData = benchmarkData.map(b => b.os);

  function initChart() {
    const canvas = document.getElementById('speedupChart');
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    const isDark = document.documentElement.classList.contains('dark');

    const gridColor = isDark ? 'rgba(71, 85, 105, 0.25)' : 'rgba(0, 0, 0, 0.06)';
    const tickColor = isDark ? '#cbd5e1' : '#64748b';
    const tooltipBg = isDark ? 'rgba(15, 23, 42, 0.95)' : 'rgba(255, 255, 255, 0.95)';
    const tooltipBorder = isDark ? '#475569' : '#e2e8f0';
    const tooltipTitle = isDark ? '#f1f5f9' : '#1e293b';
    const tooltipBody = isDark ? '#e2e8f0' : '#475569';

    new window.Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'C/RTL Cosimulation',
            data: cosimData,
            backgroundColor: 'rgba(107, 114, 128, 0.8)',
            borderColor: 'rgb(107, 114, 128)',
            borderWidth: 1,
            borderRadius: 6,
            hoverBackgroundColor: 'rgba(107, 114, 128, 1)',
          },
          {
            label: 'LightningSim',
            data: lsData,
            backgroundColor: 'rgba(245, 158, 11, 0.8)',
            borderColor: 'rgb(245, 158, 11)',
            borderWidth: 1,
            borderRadius: 6,
            hoverBackgroundColor: 'rgba(245, 158, 11, 1)',
          },
          {
            label: 'OmniSim',
            data: osData,
            backgroundColor: 'rgba(34, 197, 94, 0.8)',
            borderColor: 'rgb(34, 197, 94)',
            borderWidth: 1,
            borderRadius: 6,
            hoverBackgroundColor: 'rgba(34, 197, 94, 1)',
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        indexAxis: 'x',
        plugins: {
          legend: {
            display: true,
            position: 'top',
            labels: {
              color: tickColor,
              font: {
                size: 13,
                weight: '500',
              },
              padding: 20,
              usePointStyle: true,
              pointStyle: 'rect',
            },
          },
          tooltip: {
            enabled: true,
            backgroundColor: tooltipBg,
            borderColor: tooltipBorder,
            borderWidth: 1,
            titleColor: tooltipTitle,
            bodyColor: tooltipBody,
            padding: 12,
            cornerRadius: 8,
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': ' + context.parsed.y.toFixed(2) + 's';
              }
            }
          }
        },
        scales: {
          x: {
            grid: {
              color: gridColor,
              drawBorder: false,
            },
            ticks: {
              color: tickColor,
              font: {
                size: 12,
              },
            },
          },
          y: {
            type: 'logarithmic',
            grid: {
              color: gridColor,
              drawBorder: false,
            },
            ticks: {
              color: tickColor,
              font: {
                size: 12,
              },
              callback: function(value) {
                return value.toFixed(2) + 's';
              }
            },
            title: {
              display: true,
              text: 'Runtime (seconds, log scale)',
              color: tickColor,
              font: {
                size: 12,
                weight: 'bold',
              },
              padding: 10,
            }
          }
        },
      },
    });
  }

  // Wait for Chart.js to load
  if (window.Chart) {
    initChart();
  } else {
    document.addEventListener('DOMContentLoaded', initChart);
  }
</script>
