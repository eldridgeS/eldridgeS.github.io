---
// Benchmark chart component showing speedup comparisons
---

<section class="py-16 px-4 sm:px-6 lg:px-8 bg-slate-900">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Runtime Performance Comparison</h2>
      <p class="text-slate-400 max-w-2xl mx-auto">Actual runtimes across representative benchmarks showing dramatic acceleration compared to traditional C/RTL co-simulation</p>
    </div>

    <div class="bg-slate-800 border border-slate-700 rounded-xl p-8 shadow-lg">
      <canvas id="speedupChart"></canvas>
    </div>

    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="flex items-center gap-3 p-4 bg-slate-800 rounded-lg">
        <div class="w-4 h-4 bg-gray-500 rounded"></div>
        <span class="text-slate-300">C/RTL Cosimulation</span>
      </div>
      <div class="flex items-center gap-3 p-4 bg-slate-800 rounded-lg">
        <div class="w-4 h-4 bg-green-500 rounded"></div>
        <span class="text-slate-300">LightningSim</span>
      </div>
      <div class="flex items-center gap-3 p-4 bg-slate-800 rounded-lg">
        <div class="w-4 h-4 bg-amber-500 rounded"></div>
        <span class="text-slate-300">OmniSim</span>
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>

  // Representative benchmarks showcasing different categories
  const benchmarkData = [
    { name: 'FIR Filter', cosim: 20.12, ls: 2.43, os: 1.94 },
    { name: 'Convolution', cosim: 49.78, ls: 2.42, os: 2.46 },
    { name: 'FFT (Unopt)', cosim: 153.53, ls: 2.78, os: 2.91 },
    { name: 'Parallel Loops', cosim: 26.81, ls: 2.34, os: 2.16 },
    { name: 'FlowGNN - DGN', cosim: 996.13, ls: 26.90, os: 11.71 },
    { name: 'FlowGNN - GIN', cosim: 4219.85, ls: 28.90, os: 11.97 },
  ];

  const labels = benchmarkData.map(b => b.name);
  const cosimData = benchmarkData.map(b => b.cosim);
  const lsData = benchmarkData.map(b => b.ls);
  const osData = benchmarkData.map(b => b.os);

  function initChart() {
    const canvas = document.getElementById('speedupChart');
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');

    new window.Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'C/RTL Cosimulation',
            data: cosimData,
            backgroundColor: 'rgba(107, 114, 128, 0.8)',
            borderColor: 'rgb(107, 114, 128)',
            borderWidth: 1,
            borderRadius: 6,
            hoverBackgroundColor: 'rgba(107, 114, 128, 1)',
          },
          {
            label: 'LightningSim',
            data: lsData,
            backgroundColor: 'rgba(34, 197, 94, 0.8)',
            borderColor: 'rgb(34, 197, 94)',
            borderWidth: 1,
            borderRadius: 6,
            hoverBackgroundColor: 'rgba(34, 197, 94, 1)',
          },
          {
            label: 'OmniSim',
            data: osData,
            backgroundColor: 'rgba(245, 158, 11, 0.8)',
            borderColor: 'rgb(245, 158, 11)',
            borderWidth: 1,
            borderRadius: 6,
            hoverBackgroundColor: 'rgba(245, 158, 11, 1)',
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        indexAxis: 'x',
        plugins: {
          legend: {
            display: true,
            position: 'top',
            labels: {
              color: '#cbd5e1',
              font: {
                size: 13,
                weight: '500',
              },
              padding: 20,
              usePointStyle: true,
              pointStyle: 'rect',
            },
          },
          tooltip: {
            enabled: true,
            backgroundColor: 'rgba(15, 23, 42, 0.9)',
            borderColor: '#475569',
            borderWidth: 1,
            titleColor: '#f1f5f9',
            bodyColor: '#e2e8f0',
            padding: 12,
            cornerRadius: 6,
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': ' + context.parsed.y.toFixed(2) + 's';
              }
            }
          }
        },
        scales: {
          x: {
            grid: {
              color: 'rgba(71, 85, 105, 0.2)',
              drawBorder: false,
            },
            ticks: {
              color: '#cbd5e1',
              font: {
                size: 12,
              },
            },
          },
          y: {
            type: 'logarithmic',
            grid: {
              color: 'rgba(71, 85, 105, 0.2)',
              drawBorder: false,
            },
            ticks: {
              color: '#cbd5e1',
              font: {
                size: 12,
              },
              callback: function(value) {
                return value.toFixed(2) + 's';
              }
            },
            title: {
              display: true,
              text: 'Runtime (seconds, log scale)',
              color: '#cbd5e1',
              font: {
                size: 12,
                weight: 'bold',
              },
              padding: 10,
            }
          }
        },
      },
    });
  }

  // Wait for Chart.js to load
  if (window.Chart) {
    initChart();
  } else {
    document.addEventListener('DOMContentLoaded', initChart);
  }
</script>
