---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import type { ImageMetadata } from 'astro';

interface Slide {
  title: string;
  description: string;
  buttonText?: string;
  buttonHref?: string;
}

export interface Props {
  title?: string;
  image: {
    src: string | ImageMetadata;
    alt: string;
  };
  slides: Slide[];
}

const { 
  title = '',
  image,
  slides = []
} = Astro.props;
---

<div class="relative w-full min-h-[500px] md:min-h-[600px] overflow-hidden pt-12 pb-12 md:pt-16 md:pb-16">
  <!-- Background Image -->
  <div class="absolute inset-0 top-0">
    <Image
      src={image.src}
      alt={image.alt}
      class="w-full h-full object-cover"
    />
  </div>
  
  <!-- Dark Overlay -->
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- Content Container -->
  <div class="relative h-full flex flex-col justify-center items-center px-4 z-10 min-h-[500px] md:min-h-[600px]">
    <!-- Top Title -->
    {title && (
      <h1 class="text-3xl md:text-5xl font-bold text-center mb-8 md:mb-12">
        <span class="text-accent dark:text-white block"><span class="flicker-text">Faster Simulation.</span></span>
        <span class="text-accent dark:text-white block"><span class="flicker-text">Scalable Optimization.</span></span>
      </h1>
    )}

    <!-- Slider Box -->
    <div class="relative w-full max-w-4xl mx-auto flex items-center justify-center">
      <!-- No arrows: replaced by loading bar below -->

      <div class="bg-page dark:bg-page rounded-xl p-8 md:p-12 border border-white/10 transition-colors duration-300 shadow-2xl w-full">
        <!-- Slides Container -->
        <div class="slider-container relative min-h-64 md:min-h-52">
          {slides.map((slide, index) => (
            <div
              class="slide-item absolute inset-0 transition-all duration-700 ease-in-out flex flex-col items-center justify-center"
              data-slide={index}
              style={index === 0 ? 'opacity: 1; visibility: visible;' : 'opacity: 0; visibility: hidden;'}
            >
              <h2 class="text-default dark:text-default text-2xl md:text-3xl font-bold mb-4 text-center">
                {slide.title}
              </h2>
              <p class="text-muted dark:text-muted text-lg mb-6 leading-relaxed text-center">
                {slide.description}
              </p>
              {slide.buttonText && slide.buttonHref && (
                <a
                  href={slide.buttonHref}
                  class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-8 rounded transition-colors shadow-md"
                >
                  {slide.buttonText}
                </a>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- No arrows: replaced by loading bar below -->

      <!-- Segmented Loading Bar Indicator -->
      <div class="absolute left-1/2 -translate-x-1/2 -bottom-10 w-2/3 md:w-1/2 h-2 flex gap-1 z-20">
        {slides.map((_, index) => (
          <button
            class="slider-progress-segment flex-1 h-full rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden relative p-0 border-none outline-none transition-all duration-300"
            style={`cursor:pointer; position:relative;`}
            aria-label={`Go to slide ${index + 1}`}
            data-segment={index}
          >
            <div id={`slider-progress-bar-${index}`} class="absolute left-0 top-0 h-full bg-blue-600 transition-all duration-500" style="width:0%"></div>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  let currentSlide = 0;
  let slideInterval;
  const SLIDE_DURATION = 5000; // ms
  let isReversing = false;

  function showSlide(n, reverse = false) {
    const slides = document.querySelectorAll('.slide-item');
    if (n >= slides.length) {
      isReversing = true;
      currentSlide = 0;
    } else if (n < 0) {
      isReversing = false;
      currentSlide = slides.length - 1;
    } else {
      isReversing = reverse;
      currentSlide = n;
    }

    slides.forEach((slide, idx) => {
      (slide).style.opacity = '0';
      (slide).style.visibility = 'hidden';
      if (idx === currentSlide) {
        (slide).style.opacity = '1';
        (slide).style.visibility = 'visible';
      }
    });
    updateProgressBar();
  }

  function nextSlide() {
    showSlide(currentSlide + 1, false);
  }

  function updateProgressBar() {
    const slides = document.querySelectorAll('.slide-item');
    slides.forEach((_, idx) => {
      const bar = document.getElementById(`slider-progress-bar-${idx}`);
      if (!bar) return;
      if (idx < currentSlide) {
        bar.style.width = '100%';
        bar.style.transition = 'width 300ms linear';
      } else if (idx === currentSlide) {
        bar.style.transition = isReversing ? 'width 400ms linear' : `width ${SLIDE_DURATION}ms linear`;
        bar.style.width = isReversing ? '0%' : '100%';
        if (isReversing) {
          setTimeout(() => { bar.style.width = '0%'; }, 10);
        } else {
          bar.style.width = '0%';
          void bar.offsetWidth;
          bar.style.width = '100%';
        }
      } else {
        bar.style.width = '0%';
        bar.style.transition = 'width 300ms linear';
      }
    });
  }

  function startAutoSlide() {
    stopAutoSlide();
    slideInterval = setInterval(() => {
      if (currentSlide === document.querySelectorAll('.slide-item').length - 1) {
        showSlide(0, true); // reverse animation
      } else {
        showSlide(currentSlide + 1, false);
      }
    }, SLIDE_DURATION);
  }

  function stopAutoSlide() {
    if (slideInterval) clearInterval(slideInterval);
  }

  window.addEventListener('DOMContentLoaded', () => {
    showSlide(currentSlide);
    startAutoSlide();
    // Add click listeners to segments
    document.querySelectorAll('.slider-progress-segment').forEach((el, idx) => {
      el.addEventListener('click', () => {
        showSlide(idx);
        startAutoSlide();
      });
    });
  });
</script>

<style>
  @keyframes flicker {
    0% { color: inherit; text-shadow: none; }
    2% { color: #fbbf24; text-shadow: 0 0 10px rgba(251, 191, 36, 0.8); }
    4% { color: inherit; text-shadow: none; }
    5% { color: #fbbf24; text-shadow: 0 0 15px rgba(251, 191, 36, 0.9); }
    7% { color: inherit; text-shadow: none; }
    11% { color: #fbbf24; text-shadow: 0 0 12px rgba(251, 191, 36, 0.85); }
    13% { color: inherit; text-shadow: none; }
    100% { color: inherit; text-shadow: none; }
  }

  .flicker-text {
    animation: flicker 5s ease-in-out infinite;
  }
</style>
